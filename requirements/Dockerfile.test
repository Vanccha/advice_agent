FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /workspace
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY company/requirements.txt /tmp/company.txt
COPY integrations/requirements.txt /tmp/integrations.txt
COPY assistant/requirements.txt /tmp/assistant.txt
COPY requirements/all.txt /tmp/all.txt
RUN sed -e 's#../company/requirements.txt#/tmp/company.txt#' \
        -e 's#../integrations/requirements.txt#/tmp/integrations.txt#' \
        -e 's#../assistant/requirements.txt#/tmp/assistant.txt#' /tmp/all.txt > /tmp/all.resolved.txt \
    && pip install --no-cache-dir -r /tmp/all.resolved.txt
CMD ["pytest"]
